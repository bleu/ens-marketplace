# Envio indexer's own Postgres (separate from apps/api's database)
ENVIO_PG_USER=postgres
ENVIO_PG_PASSWORD=
ENVIO_PG_DATABASE=envio

# Real token from https://envio.dev/app/api-tokens — enables HyperSync for Sepolia
# indexing (see apps/indexer/config.production.yaml)
ENVIO_API_TOKEN=

# Shared between graphql-engine and the indexer/api services that talk to it
HASURA_GRAPHQL_ADMIN_SECRET=

# apps/api's own database (Grails listings)
API_PG_USER=postgres
API_PG_PASSWORD=
API_PG_DATABASE=ens_marketplace_api

# Host port apps/api is published on — Caddy reverse-proxies to this
API_EXPOSED_PORT=41000
