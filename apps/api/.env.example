# Postgres connection string. Any real Postgres works — Prisma is host-agnostic.
# For local dev, run a throwaway instance: `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`
# In production, point this at the AWS RDS instance once it exists — no code changes needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grails?schema=public

PORT=3001
